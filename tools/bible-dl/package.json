{
  "name": "bible-dl",
  "version": "0.1.0",
  "description": "bible-dl: a command-line tool to download, validate, merge and preprocess Bible text using bible-crawler.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "bible-dl": "bin/bible-dl"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prebuild": "npm --prefix ../bible-crawler run build",
    "pretest": "npm --prefix ../bible-crawler run build",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/churchstudio-org/openbible.git"
  },
  "author": "Church Studio",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bible-crawler": "*",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
